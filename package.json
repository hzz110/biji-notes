{
  "name": "biji-online-notes",
  "version": "1.0.0",
  "type": "module",
  "description": "在线笔记应用 - 使用 Cloudflare Pages 部署",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 execute biji-notes-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute biji-notes-db --local --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-quill": "^2.0.0",
    "quill": "^1.3.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/quill": "^2.0.10",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "wrangler": "^3.19.0"
  }
}

